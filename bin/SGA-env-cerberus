#!/bin/bash
# Set up SGA code

echo 'Loading SGA project'
micromamba activate SGA

export DESI_ROOT=$IM_WORK_DIR/desi
export SGA_DIR=$IM_PROJECTS_DIR/SGA/2025
export SGA_PUBLIC_DIR=$IM_PROJECTS_DIR/SGA/2025/public
export SGA_DATA_DIR=$IM_PROJECTS_DIR/SGA/2025/data
export SGA_HTML_DIR=$IM_PROJECTS_DIR/SGA/2025/html
export SGA_CODE_DIR=/Users/ioannis/code/SGA

# python -m pip install . --no-cache-dir --force-reinstall --no-deps
export IM_CODE_DIR=${HOME}/code
export SPS_HOME=${IM_CODE_DIR}/python-fsps/src/fsps/libfsps

echo 'DESI_ROOT='$DESI_ROOT
echo 'SGA_DIR='$SGA_DIR
echo 'SGA_PUBLIC_DIR='$SGA_PUBLIC_DIR
echo 'SGA_DATA_DIR='$SGA_DATA_DIR
echo 'SGA_HTML_DIR='$SGA_HTML_DIR
echo 'SGA_CODE_DIR='$SGA_CODE_DIR

export PATH=${IM_CODE_DIR}/desihub/fastspecfit/bin:${PATH}
export PYTHONPATH=${IM_CODE_DIR}/desihub/fastspecfit/py:${PYTHONPATH}

export PATH=$SGA_CODE_DIR/bin:${PATH}
export PYTHONPATH=$SGA_CODE_DIR/py:${PYTHONPATH}
